<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the watch app's generated Info.plist.
     workout-processing: the hiking workout keeps TrailWatch running with the wrist down.
     location: CLBackgroundActivitySession keeps GPS going when Health access isn't given. -->
<plist version="1.0">
<dict>
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
</dict>
</plist>
